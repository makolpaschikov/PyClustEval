  "compatibility_patches": [
    {
      "file": "clustering_eval/third_party/fkdc/utils.py",
      "original": "clustering_eval/third_party/fkdc/utils_original.txt",
      "changes": [
        "scalar min(a,b) -> numpy.minimum(a,b) because numpy wildcard import shadows Python min",
        "uninitialized shared-neighbor index buffer initialized to -1 sentinel to prevent false matches and 0/0 similarity warnings"
      ]
    },
    {
      "file": "clustering_eval/third_party/nnfc/utils.py",
      "original": "clustering_eval/third_party/nnfc/utils_original.txt",
      "changes": [
        "fix one mixed tab/space indentation causing TabError",
        "scalar min(a,b) -> numpy.minimum(a,b) because numpy wildcard import shadows Python min",
        "O(m^2) all-pairs max-ratio loop replaced by mathematically equivalent max(arr)/min(arr) for positive folded-uniform values",
        "uninitialized shared-neighbor index buffer initialized to -1 sentinel to prevent false matches and 0/0 similarity warnings"
      ]
    },
    {
      "file": "clustering_eval/third_party/fdbscan/fd_dbscan.py",
      "original": "clustering_eval/third_party/fdbscan/fd_dbscan_original.py",
      "changes": [
        "dense d-dimensional count tensor replaced by sparse occupied-cell dictionary with identical returned cell counts",
        "3**d Cartesian neighbor enumeration replaced by direct construction of the same 2*d axial neighbors"
      ]
    }
  ]
